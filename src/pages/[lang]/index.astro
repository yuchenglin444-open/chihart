---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HomeCollage from '../../components/HomeCollage.astro';
import { ui, localizedPath, isLang, asset } from '../../i18n/ui';
import { artworkSrc, artworkAlt } from '../../lib/media';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
).slice(0, 3);

const exhibitions = await getCollection('exhibitions');
const current = exhibitions.find((item) => item.data.status === 'current') ?? exhibitions[0];
const currentTitle = current
  ? (lang === 'zh' ? current.data.titleZh : current.data.titleEn)
  : '';
const currentVenue = current
  ? (lang === 'zh' ? current.data.venueZh : current.data.venueEn)
  : '';
const currentDates = current
  ? (lang === 'zh' ? current.data.dateLabelZh : current.data.dateLabelEn)
  : '';
const currentSummary = current
  ? (lang === 'zh' ? current.data.summaryZh : current.data.summaryEn)
  : '';
const currentWorks = current
  ? current.data.artworks.slice(0, 5).map((work) => {
      const title = lang === 'zh' ? work.titleZh : work.titleEn;
      return {
        src: artworkSrc(work.src),
        alt: artworkAlt(lang, work.src, title),
        caption: title,
      };
    })
  : [];

const editorialLead = t.about.intro[0];
const editorialSupport = t.about.intro[1];

const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const workSpans = [
  'md:col-span-5 md:row-span-2',
  'md:col-span-5 md:row-span-1',
  'md:col-span-5 md:row-span-1',
  'md:col-span-6 md:row-span-1',
  'md:col-span-6 md:row-span-1',
];
---

<Layout lang={lang} page="/">
  <HomeCollage lang={lang} />

  <section class="wrap py-20 sm:py-24 md:py-32" data-reveal>
    <span class="eyebrow">{t.home.heroKicker}</span>
    <h1 class="editorial mt-6 max-w-5xl text-4xl sm:text-5xl md:text-6xl lg:text-7xl">{editorialLead}</h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl">{t.home.heroSub}</p>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg">{editorialSupport}</p>
    <div class="mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
      <a href={localizedPath('/works', lang)} class="btn btn-primary">{t.cta.viewWorks}</a>
      <a href={localizedPath('/exhibitions', lang)} class="btn btn-ghost">{t.cta.viewExhibitions}</a>
      <a href={localizedPath('/members', lang)} class="btn btn-ghost">{t.cta.viewMembers}</a>
    </div>
  </section>

  {current && (
    <section class="border-t border-[var(--color-line)]">
      <div class="wrap py-16 sm:py-20">
        <div class="flex items-end justify-between gap-6" data-reveal>
          <div>
            <span class="eyebrow">{t.home.exhibitionEyebrow}</span>
            <h2 class="editorial mt-4 text-3xl sm:text-4xl md:text-5xl">{t.home.exhibitionTitle}</h2>
          </div>
          <a href={localizedPath('/exhibitions', lang)} class="link-underline shrink-0">{t.cta.viewAll} →</a>
        </div>

        <div class="exhibit-bento mt-10" data-lightbox-group="home-exhibition">
          <a
            href={localizedPath(`/exhibitions/${current.id}`, lang)}
            class="group relative min-h-[16rem] overflow-hidden bg-[var(--color-paper-deep)] md:col-span-7 md:row-span-2"
            data-reveal
          >
            <img
              src={asset(artworkSrc(current.data.hero))}
              alt={artworkAlt(lang, current.data.hero, currentTitle)}
              class="img-zoom h-full w-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[var(--color-azurite-deep)]/88 via-[var(--color-azurite-deep)]/40 to-transparent p-5 sm:p-7">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-gold)]">{t.exhibitions.currentBadge}</p>
              <h3 class="editorial mt-2 text-2xl text-[var(--color-paper)] sm:text-3xl md:text-4xl">{currentTitle}</h3>
              <p class="mt-2 text-sm text-[var(--color-paper)]/90 sm:text-base">{currentVenue}</p>
              <p class="text-sm text-[var(--color-paper)]/75">{currentDates}</p>
            </div>
          </a>

          {currentWorks.map((work, i) => (
            <div
              class:list={['group relative min-h-[10rem] overflow-hidden bg-[var(--color-paper-deep)]', workSpans[i] ?? 'md:col-span-6']}
              data-reveal
              data-reveal-delay={String((i % 3) + 1)}
            >
              <button
                type="button"
                class="block h-full w-full"
                data-lightbox-item
                data-lightbox-src={asset(work.src)}
                data-lightbox-alt={work.alt}
                data-lightbox-caption={work.caption}
              >
                <img src={asset(work.src)} alt={work.alt} loading="lazy" decoding="async" class="img-zoom h-full w-full object-cover" />
              </button>
            </div>
          ))}
        </div>

        <p class="mt-6 max-w-2xl text-base text-[var(--color-ink-soft)]" data-reveal>{currentSummary}</p>
        <a href={localizedPath(`/exhibitions/${current.id}`, lang)} class="link-underline mt-3 inline-block" data-reveal>{t.cta.learnMore} →</a>
      </div>
    </section>
  )}

  <section class="border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
    <div class="wrap py-16 sm:py-20">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <span class="eyebrow">{t.home.newsEyebrow}</span>
          <h2 class="editorial mt-4 text-3xl sm:text-4xl md:text-5xl">{t.home.newsTitle}</h2>
        </div>
        <a href={localizedPath('/news', lang)} class="link-underline shrink-0">{t.cta.viewAll} →</a>
      </div>
      <div class="mt-10 grid gap-3 sm:grid-cols-3">
        {news.map((item, i) => (
          <a
            href={localizedPath(`/news/${item.id}`, lang)}
            class="group block overflow-hidden"
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div class="aspect-[16/11] overflow-hidden">
              <img src={asset(artworkSrc(item.data.image))} alt={artworkAlt(lang, item.data.image, lang === 'zh' ? item.data.titleZh : item.data.titleEn)} class="img-zoom h-full w-full object-cover" />
            </div>
            <div class="pt-4">
              <p class="text-sm text-[var(--color-muted)]">{formatDate(item.data.date)}</p>
              <h3 class="mt-2 font-serif text-xl leading-snug sm:text-2xl">{lang === 'zh' ? item.data.titleZh : item.data.titleEn}</h3>
              <p class="mt-3 text-base text-[var(--color-ink-soft)]">{lang === 'zh' ? item.data.summaryZh : item.data.summaryEn}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
