---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ui, localizedPath, asset, isLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];

const exhibitions = await getCollection('exhibitions');
const current = exhibitions.filter((item) => item.data.status === 'current');
const past = exhibitions.filter((item) => item.data.status === 'past');

const card = (item: (typeof exhibitions)[number], badge: string) => {
  const title = lang === 'zh' ? item.data.titleZh : item.data.titleEn;
  const venue = lang === 'zh' ? item.data.venueZh : item.data.venueEn;
  const dates = lang === 'zh' ? item.data.dateLabelZh : item.data.dateLabelEn;
  const summary = lang === 'zh' ? item.data.summaryZh : item.data.summaryEn;
  return { item, title, venue, dates, summary, badge };
};
---

<Layout lang={lang} page="/exhibitions" title={t.exhibitions.title} description={t.exhibitions.lede}>
  <PageHeader eyebrow={t.exhibitions.eyebrow} title={t.exhibitions.title} lede={t.exhibitions.lede} />

  <section class="wrap py-16">
    <h2 class="text-3xl" data-reveal>{t.exhibitions.currentTitle}</h2>
    <div class="mt-8 grid gap-8">
      {current.map((raw) => {
        const item = card(raw, t.exhibitions.currentBadge);
        return (
          <a
            href={localizedPath(`/exhibitions/${raw.id}`, lang)}
            class="card-hover grid overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] lg:grid-cols-2"
            data-reveal
          >
            <div class="aspect-[16/11] overflow-hidden">
              <img src={asset(raw.data.hero)} alt={item.title} class="img-zoom h-full w-full object-cover" />
            </div>
            <div class="flex flex-col justify-center p-8">
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{item.badge}</p>
              <h3 class="mt-3 text-3xl">{item.title}</h3>
              <p class="mt-4 text-[var(--color-ink-soft)]">{item.venue}</p>
              <p class="text-[var(--color-muted)]">{item.dates}</p>
              <p class="mt-4 text-[var(--color-ink-soft)]">{item.summary}</p>
              <span class="mt-6 link-underline">{t.cta.learnMore} →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
    <div class="wrap py-16">
      <h2 class="text-3xl" data-reveal>{t.exhibitions.pastTitle}</h2>
      {past.length === 0 && <p class="mt-6 text-[var(--color-muted)]" data-reveal>{t.exhibitions.pastEmpty}</p>}
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {past.map((raw) => {
          const item = card(raw, t.exhibitions.pastBadge);
          return (
            <a
              href={localizedPath(`/exhibitions/${raw.id}`, lang)}
              class="card-hover overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)]"
              data-reveal
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img src={asset(raw.data.hero)} alt={item.title} class="img-zoom h-full w-full object-cover" />
              </div>
              <div class="p-6">
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{item.badge}</p>
                <h3 class="mt-2 text-2xl">{item.title}</h3>
                <p class="mt-3 text-[var(--color-ink-soft)]">{item.venue}</p>
                <p class="text-[var(--color-muted)]">{item.dates}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
