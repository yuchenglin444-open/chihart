---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ArtworkGallery from '../../../components/ArtworkGallery.astro';
import { ui, localizedPath, asset, isLang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const items = await getCollection('exhibitions');
  return ['zh', 'en'].flatMap((lang) =>
    items.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry },
    })),
  );
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const title = lang === 'zh' ? d.titleZh : d.titleEn;
const summary = lang === 'zh' ? d.summaryZh : d.summaryEn;
const venue = lang === 'zh' ? d.venueZh : d.venueEn;
const dates = lang === 'zh' ? d.dateLabelZh : d.dateLabelEn;
const organizers = lang === 'zh' ? d.organizersZh : d.organizersEn;
const related = lang === 'zh' ? d.relatedEventsZh : d.relatedEventsEn;
const badge = d.status === 'current' ? t.exhibitions.currentBadge : t.exhibitions.pastBadge;
const works = d.artworks.map((work) => ({
  src: work.src,
  alt: lang === 'zh' ? work.titleZh : work.titleEn,
  caption: lang === 'zh' ? work.titleZh : work.titleEn,
}));
---

<Layout lang={lang} page={`/exhibitions/${entry.id}`} title={title} description={summary}>
  <article class="exhibition-detail">
    <header class="relative isolate overflow-hidden border-b border-[var(--color-line)]">
      <div class="absolute inset-0">
        <img src={asset(d.hero)} alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-[rgba(22,58,77,0.62)]"></div>
      </div>
      <div class="wrap relative py-20 text-[#F6F1E6] sm:py-28" data-reveal>
        <a href={localizedPath('/exhibitions', lang)} class="text-[#F6F1E6] underline-offset-4 hover:underline">{t.cta.backToExhibitions}</a>
        <p class="mt-6 text-sm font-bold uppercase tracking-[0.16em] text-[#E8C9A3]">{badge}</p>
        <h1 class="mt-4 max-w-4xl text-4xl text-[#F6F1E6] sm:text-5xl md:text-6xl">{title}</h1>
        <p class="mt-6 max-w-2xl text-lg text-[#F6F1E6]/90">{summary}</p>
      </div>
    </header>

    <section class="wrap grid gap-8 py-16 md:grid-cols-3">
      <div class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6" data-reveal>
        <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.exhibitions.datesLabel}</h2>
        <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{dates}</p>
      </div>
      <div class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6" data-reveal data-reveal-delay="1">
        <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.exhibitions.venueLabel}</h2>
        <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{venue}</p>
      </div>
      <div class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6" data-reveal data-reveal-delay="2">
        <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.exhibitions.organizersLabel}</h2>
        <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{organizers}</p>
      </div>
    </section>

    <section class="wrap-narrow pb-8 text-lg leading-relaxed text-[var(--color-ink-soft)]" data-reveal>
      <Content />
    </section>

    <section class="border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
      <div class="wrap py-16" data-reveal>
        <h2 class="text-3xl">{t.exhibitions.worksLabel}</h2>
        <div class="mt-8">
          <ArtworkGallery items={works} group={`exhibition-${entry.id}`} />
        </div>
      </div>
    </section>

    <section class="wrap py-16" data-reveal>
      <h2 class="text-3xl">{t.exhibitions.relatedLabel}</h2>
      <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">{related}</p>
    </section>
  </article>
</Layout>
