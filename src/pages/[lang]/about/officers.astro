---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ui, localizedPath, asset, isLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];

const slots = Array.from({ length: 8 }, (_, i) => i);
---

<Layout lang={lang} page="/about/officers" title={t.officers.title} description={t.officers.lede}>
  <PageHeader eyebrow={t.officers.eyebrow} title={t.officers.title} lede={t.officers.lede} />
  <section class="wrap py-16">
    <a href={localizedPath('/about', lang)} class="link-underline">{t.cta.backToAbout}</a>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {slots.map((i) => (
        <article class="overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)]" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <div class="aspect-[4/5] bg-[var(--color-azurite-soft)]">
            <img src={asset('/images/placeholders/placeholder-portrait-01.svg')} alt={t.officers.vacant} class="h-full w-full object-cover" />
          </div>
          <div class="p-5">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.officers.titleLabel}</p>
            <p class="mt-1 text-[var(--color-ink-soft)]">{t.officers.vacant}</p>
            <p class="mt-4 text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.officers.nameLabel}</p>
            <p class="mt-1 text-xl">{t.officers.vacant}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
