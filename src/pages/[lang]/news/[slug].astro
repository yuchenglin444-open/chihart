---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { ui, localizedPath, asset, isLang } from '../../../i18n/ui';
import { artworkSrc, artworkAlt } from '../../../lib/media';

export async function getStaticPaths() {
  const items = await getCollection('news');
  return ['zh', 'en'].flatMap((lang) =>
    items.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry },
    })),
  );
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = lang === 'zh' ? entry.data.titleZh : entry.data.titleEn;
const summary = lang === 'zh' ? entry.data.summaryZh : entry.data.summaryEn;
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout lang={lang} page={`/news/${entry.id}`} title={title} description={summary}>
  <article>
    <header class="border-b border-[var(--color-line)] bg-[var(--color-paper-deep)]">
      <div class="wrap py-4 sm:py-5" data-reveal>
        <a href={localizedPath('/news', lang)} class="link-underline text-sm">{t.cta.backToNews}</a>
        <div class="mt-2 flex items-center gap-3 text-xs text-[var(--color-muted)] sm:text-sm">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          {entry.data.placeholder && (
            <span class="rounded-[2px] border border-[var(--color-line)] px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-[var(--color-ochre)]">
              {t.news.placeholderBadge}
            </span>
          )}
        </div>
        <h1 class="mt-1 max-w-3xl text-2xl leading-tight sm:text-3xl">{title}</h1>
        <p class="mt-2 max-w-2xl text-sm text-[var(--color-ink-soft)] sm:text-base">{summary}</p>
      </div>
    </header>
    <div class="wrap grid gap-10 py-16 lg:grid-cols-12">
      <div class="overflow-hidden rounded-[2px] border border-[var(--color-line)] lg:col-span-5" data-reveal>
        <img src={asset(artworkSrc(entry.data.image))} alt={artworkAlt(lang, entry.data.image, title)} class="h-full w-full object-cover" />
      </div>
      <div class="max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] lg:col-span-7" data-reveal>
        <Content />
      </div>
    </div>
  </article>
</Layout>
