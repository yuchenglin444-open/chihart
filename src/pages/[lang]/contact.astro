---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { ui, org, isLang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];
const address = lang === 'zh' ? org.addressZh : org.addressEn;
---

<Layout lang={lang} page="/contact" title={t.contact.title} description={t.contact.lede}>
  <PageHeader eyebrow={t.contact.eyebrow} title={t.contact.title} lede={t.contact.lede} />
  <section class="wrap grid gap-8 py-16 md:grid-cols-2">
    <article class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-8" data-reveal>
      <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.contact.emailLabel}</h2>
      <a href={`mailto:${org.email}`} class="mt-4 block text-2xl link-underline">{org.email}</a>
    </article>
    <article class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-8" data-reveal data-reveal-delay="1">
      <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.contact.addressLabel}</h2>
      <p class="mt-4 text-2xl text-[var(--color-ink-soft)]">{address}</p>
    </article>
  </section>
</Layout>
