---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ArtworkGallery from '../../../components/ArtworkGallery.astro';
import { ui, isLang } from '../../../i18n/ui';
import { artworkSrc, artworkAlt, isDefaultArtwork } from '../../../lib/media';
import { allPaintings } from '../../../lib/photos';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];
const fallback = t.home.worksCaption;

const items = allPaintings().map((src) => {
  const resolved = artworkSrc(src);
  const known = isDefaultArtwork(resolved);
  const alt = artworkAlt(lang, resolved, fallback);
  return {
    src: resolved,
    alt,
    caption: alt,
    filter: known ? 'chen-chanjuan' : 'tbd',
  };
});
---

<Layout lang={lang} page="/works" title={t.works.title} description={t.works.lede}>
  <PageHeader eyebrow={t.works.eyebrow} title={t.works.title} lede={t.works.lede} />

  <section class="wrap py-8 sm:py-10">
    <div class="flex flex-wrap items-center gap-2" data-filter-bar role="group" aria-label={t.works.filterLabel}>
      <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">{t.works.filterAll}</button>
      <button type="button" class="filter-chip" data-filter="chen-chanjuan" aria-pressed="false">{t.works.filterKnownArtist}</button>
      <button type="button" class="filter-chip" data-filter="tbd" aria-pressed="false">{t.works.filterTbd}</button>
    </div>

    <div class="mt-6" data-reveal>
      <ArtworkGallery items={items} group="works-gallery" layout="masonry" />
    </div>
  </section>
</Layout>

<script>
  function initFilters() {
    const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
    const root = document.querySelector<HTMLElement>('[data-filter-root]');
    if (!bar || !root) return;
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-item]'));

    const apply = (key: string) => {
      chips.forEach((chip) => {
        const on = chip.dataset.filter === key;
        chip.setAttribute('aria-pressed', String(on));
      });
      items.forEach((item) => {
        const match = key === 'all' || item.dataset.filterItem === key;
        item.hidden = !match;
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => apply(chip.dataset.filter || 'all'));
    });
  }

  document.addEventListener('astro:page-load', initFilters);
</script>
