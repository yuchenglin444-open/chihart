---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ArtworkGallery from '../../../components/ArtworkGallery.astro';
import JumpBar from '../../../components/JumpBar.astro';
import { ui, localizedPath, asset, isLang } from '../../../i18n/ui';
import { artworkSrc, artworkAlt } from '../../../lib/media';

export async function getStaticPaths() {
  const members = (await getCollection('members')).filter((m) => m.data.published);
  return ['zh', 'en'].flatMap((lang) =>
    members.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry },
    })),
  );
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Invalid locale');
const lang = langParam;
const t = ui[lang];
const { entry } = Astro.props;
const d = entry.data;
const name = lang === 'zh' ? d.nameZh : d.nameEn;
const role = lang === 'zh' ? d.titleZh : d.titleEn;
const bio = lang === 'zh' ? d.bioZh : d.bioEn;
const education = lang === 'zh' ? d.educationZh : d.educationEn;
const awards = lang === 'zh' ? d.awardsZh : d.awardsEn;
const exhibitions = lang === 'zh' ? d.exhibitionsZh : d.exhibitionsEn;
const contact = lang === 'zh' ? d.contactZh : d.contactEn;
const qrSrc = asset(`/qr/${entry.id}.png`);
const works = d.works.map((work) => {
  const title = lang === 'zh' ? work.titleZh : work.titleEn;
  return {
    src: artworkSrc(work.src),
    alt: artworkAlt(lang, work.src, title),
    caption: title,
  };
});
---

<Layout lang={lang} page={`/members/${entry.id}`} title={name} description={bio}>
  <article class="member-profile pb-24">
    <header class="border-b border-[var(--color-line)]">
      <div class="wrap py-5 sm:py-6">
        <a href={localizedPath('/members', lang)} class="link-underline text-sm">{t.cta.backToMembers}</a>
        <h1 class="editorial mt-3 text-2xl sm:text-3xl md:text-4xl">{name}</h1>
        <p class="mt-2 text-base text-[var(--color-muted)] sm:text-lg">{t.members.roleLabel}：{role}</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">{t.members.lineNameLabel}：{d.lineName}</p>
      </div>
    </header>

    <JumpBar
      label={t.members.jumpNav}
      items={[
        { href: '#member-works', label: t.members.jumpWorks },
        { href: '#member-bio', label: t.members.jumpBio },
        { href: '#member-contact', label: t.members.jumpContact },
      ]}
    />

    <section id="member-works" class="scroll-mt-20">
      <div class="wrap py-10 sm:py-14" data-reveal>
        <h2 class="editorial text-3xl sm:text-4xl">{t.members.worksLabel}</h2>
        <div class="mt-6">
          <ArtworkGallery items={works} group={`member-${entry.id}`} layout="masonry" />
        </div>
      </div>
    </section>

    <section id="member-bio" class="scroll-mt-20 border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
      <div class="wrap py-10 sm:py-14" data-reveal>
        <h2 class="editorial text-3xl sm:text-4xl">{t.members.bioLabel}</h2>
        <div class="mt-8 grid items-start gap-8 lg:grid-cols-12">
          <div class="overflow-hidden bg-[var(--color-azurite-soft)] lg:col-span-4">
            <img src={asset(d.portrait)} alt={name} class="aspect-[4/5] w-full object-cover" />
          </div>
          <div class="lg:col-span-8">
            <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl">{bio}</p>
            <h3 class="mt-10 font-serif text-2xl">{t.members.resumeLabel}</h3>
            <dl class="mt-6 grid gap-5 sm:grid-cols-3">
              <div>
                <dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.members.educationLabel}</dt>
                <dd class="mt-3 text-[var(--color-ink-soft)]">{education}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.members.awardsLabel}</dt>
                <dd class="mt-3 text-[var(--color-ink-soft)]">{awards}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-ochre)]">{t.members.exhibitionsLabel}</dt>
                <dd class="mt-3 text-[var(--color-ink-soft)]">{exhibitions}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="member-contact" class="scroll-mt-20 border-t border-[var(--color-line)]">
      <div class="wrap py-10 sm:py-14" data-reveal>
        <h2 class="editorial text-3xl sm:text-4xl">{t.members.contactLabel}</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2">
          <div>
            <p class="text-lg leading-relaxed text-[var(--color-ink-soft)]">{contact}</p>
          </div>
          <aside class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6">
            <h3 class="text-lg">{t.members.qrLabel}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{t.members.qrHelp}</p>
            <img src={qrSrc} alt={`${name} QR code`} class="mt-5 w-full max-w-[220px] border border-[var(--color-line)] bg-white p-2" />
            <a href={qrSrc} download={`${entry.id}-qr.png`} class="btn btn-primary mt-5 w-full sm:w-auto">{t.cta.downloadQr}</a>
          </aside>
        </div>
      </div>
    </section>
  </article>
</Layout>
