---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JoinUs from '../components/JoinUs.astro';
import Lightbox from '../components/Lightbox.astro';
import { ui, org, asset, type Lang } from '../i18n/ui';
import { DEFAULT_ARTWORK, DEFAULT_ARTWORK_ALT } from '../lib/media';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  page?: string;
}

const { lang, title, description, page = '/' } = Astro.props;
const compactNav = page !== '/';
const t = ui[lang];
const siteName = lang === 'zh' ? org.nameZh : `${org.nameEn} (${org.abbr})`;
const pageTitle = title ? `${title}｜${siteName}` : siteName;
const desc = description ?? t.footer.tagline;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta property="og:image" content={new URL(asset(DEFAULT_ARTWORK), Astro.site)} />
    <meta property="og:image:alt" content={DEFAULT_ARTWORK_ALT[lang]} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Serif+TC:wght@500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[var(--color-azurite-deep)] focus:px-4 focus:py-2 focus:text-white"
    >
      {t.a11y.skip}
    </a>
    <Header lang={lang} page={page} compact={compactNav} />
    <main id="main" class="page-enter flex-1">
      <slot />
    </main>
    {page !== '/contact' && <JoinUs lang={lang} />}
    <Footer lang={lang} flushTop={page !== '/contact'} />
    <Lightbox lang={lang} />
    <script>
      function initReveal() {
        const nodes = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!nodes.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          nodes.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
        );
        nodes.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
