---
interface Item {
  href: string;
  label: string;
}
interface Props {
  items: Item[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav class="jump-bar" aria-label={label} data-jump-bar>
  {items.map((item) => (
    <a href={item.href} data-jump-link={item.href}>{item.label}</a>
  ))}
</nav>

<script>
  function initJumpBar() {
    const bar = document.querySelector<HTMLElement>('[data-jump-bar]');
    if (!bar) return;
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('[data-jump-link]'));
    const sections = links
      .map((link) => {
        const id = link.getAttribute('data-jump-link')?.replace('#', '');
        const el = id ? document.getElementById(id) : null;
        return el ? { link, el } : null;
      })
      .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => x !== null);

    const setActive = (hash: string) => {
      links.forEach((link) => {
        const on = link.getAttribute('data-jump-link') === hash;
        link.classList.toggle('is-active', on);
        if (on) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive('#' + visible.target.id);
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0.1, 0.3, 0.6] },
    );
    sections.forEach(({ el }) => io.observe(el));
    if (sections[0]) setActive('#' + sections[0].el.id);

    const hideAt = document.querySelector('section[aria-labelledby="join-us-heading"], footer');
    if (hideAt) {
      const hideIo = new IntersectionObserver(
        (entries) => {
          const on = entries.some((e) => e.isIntersecting);
          bar.classList.toggle('is-away', on);
        },
        { threshold: 0.08 },
      );
      hideIo.observe(hideAt);
    }
  }

  document.addEventListener('astro:page-load', initJumpBar);
</script>
