---
import { asset } from '../i18n/ui';
import { artworkSrc } from '../lib/media';

export interface ArtworkItem {
  src: string;
  alt: string;
  caption?: string;
  filter?: string;
}

interface Props {
  items: ArtworkItem[];
  group: string;
  layout?: 'grid' | 'masonry';
}

const { items: rawItems, group, layout = 'grid' } = Astro.props;
const items = rawItems.map((item) => ({ ...item, src: artworkSrc(item.src) }));
const masonry = layout === 'masonry';
---

<div
  class:list={[masonry ? 'masonry-grid' : 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3']}
  data-lightbox-group={group}
  data-filter-root
>
  {items.map((item) => (
    <figure
      class:list={[
        'group overflow-hidden bg-[var(--color-surface)]',
        masonry ? '' : 'rounded-[2px] border border-[var(--color-line)]',
      ]}
      data-filter-item={item.filter ?? ''}
    >
      <button
        type="button"
        class:list={[
          'relative block w-full overflow-hidden',
          masonry ? '' : 'aspect-[4/5]',
        ]}
        data-lightbox-item
        data-lightbox-src={asset(item.src)}
        data-lightbox-alt={item.alt}
        data-lightbox-caption={item.caption ?? item.alt}
      >
        <img
          src={asset(item.src)}
          alt={item.alt}
          loading="lazy"
          decoding="async"
          class:list={['img-zoom w-full object-cover', masonry ? 'h-auto' : 'h-full']}
        />
      </button>
      {item.caption && !masonry && (
        <figcaption class="px-4 py-3 text-sm text-[var(--color-muted)]">{item.caption}</figcaption>
      )}
    </figure>
  ))}
</div>
