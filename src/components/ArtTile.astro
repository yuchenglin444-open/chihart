---
import { asset } from '../i18n/ui';

interface Props {
  src: string;
  alt?: string;
  ratio?: string; // e.g. 'aspect-[4/5]'
}
const { src, alt = '膠彩作品', ratio = 'aspect-[4/5]' } = Astro.props;
---

<figure class="group relative overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)]">
  <div class:list={[ratio, 'relative w-full overflow-hidden']}>
    <img
      src={asset(src)}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
    />
  </div>
</figure>
