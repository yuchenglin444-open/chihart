---
import { ui, org, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const contactHref = localizedPath('/contact', lang);
---

<section class="border-t border-[var(--color-line)] bg-[var(--color-azurite-soft)]" aria-labelledby="join-us-heading">
  <div class="wrap py-16 text-center sm:py-20 md:py-24" data-reveal>
    <h2 id="join-us-heading" class="text-3xl leading-tight sm:text-4xl">{t.joinUs.title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-[var(--color-ink-soft)] sm:mt-6 sm:text-lg">
      {t.joinUs.lede}
    </p>
    <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:mt-10 sm:flex-row sm:items-center sm:gap-4">
      <a href={contactHref} class="btn btn-primary w-full sm:w-auto">{t.joinUs.cta}</a>
      <a href={`mailto:${org.email}`} class="btn btn-ghost w-full sm:w-auto">{t.joinUs.emailCta}</a>
    </div>
  </div>
</section>
