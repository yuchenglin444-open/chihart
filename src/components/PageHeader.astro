---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="border-b border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap py-4 sm:py-5" data-reveal>
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="mt-1 max-w-3xl text-2xl leading-tight sm:text-3xl">{title}</h1>
    {lede && <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-ink-soft)] sm:text-base">{lede}</p>}
  </div>
</section>
