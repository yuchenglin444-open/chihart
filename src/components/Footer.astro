---
import { ui, navItems, org, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const items = navItems(lang);
const siteName = lang === 'zh' ? org.nameZh : org.nameEn;
const address = lang === 'zh' ? org.addressZh : org.addressEn;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(org.mapsQuery)}`;
const year = 2026; // update yearly, or wire to build date
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <!-- Brand / tagline -->
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-[2px] bg-[var(--color-jade)] font-serif text-lg text-[var(--color-ink)]">七</span>
        <span class="font-serif text-lg font-semibold">{siteName}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--color-muted)]">{t.footer.tagline}</p>
      <p class="mt-3 text-xs text-[var(--color-muted)]">{t.footer.builtNote}</p>
    </div>

    <!-- Quick links -->
    <div class="md:col-span-3">
      <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{t.footer.quickLinks}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {items.map((item) => (
          <li><a href={item.href} class="text-[var(--color-ink-soft)] transition hover:text-[var(--color-seal)]">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Visit -->
    <div class="md:col-span-4">
      <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{t.footer.visit}</h3>
      <address class="mt-4 text-sm not-italic leading-relaxed text-[var(--color-ink-soft)]">
        {address}
      </address>
      <a href={mapHref} target="_blank" rel="noopener" class="mt-2 inline-block text-sm link-underline">{t.contact.mapLabel} →</a>

      <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{t.footer.follow}</h3>
      <a href={org.facebook} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm link-underline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        Facebook
      </a>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="wrap flex flex-col items-center justify-between gap-2 py-5 text-xs text-[var(--color-muted)] sm:flex-row">
      <p>© {year} {siteName}. {t.footer.rights}.</p>
      <p>{org.addressZh}</p>
    </div>
  </div>
</footer>
