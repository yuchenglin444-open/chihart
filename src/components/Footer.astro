---
import { ui, navItems, org, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const items = navItems(lang);
const siteName = lang === 'zh' ? org.nameZh : org.nameEn;
const address = lang === 'zh' ? org.addressZh : org.addressEn;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(org.mapsQuery)}`;
const year = 2026; // update yearly, or wire to build date
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <!-- Brand / tagline -->
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded-[2px] bg-[var(--color-jade)] font-serif text-2xl font-bold text-[var(--color-ink)]">七</span>
        <span class="font-serif text-xl font-bold">{siteName}</span>
      </div>
      <p class="mt-4 max-w-sm text-base leading-relaxed text-[var(--color-muted)]">{t.footer.tagline}</p>
      <p class="mt-3 text-sm text-[var(--color-muted)]">{t.footer.builtNote}</p>
    </div>

    <!-- Quick links -->
    <div class="md:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-gold)]">{t.footer.quickLinks}</h3>
      <ul class="mt-4 space-y-2 text-base font-medium">
        {items.map((item) => (
          <li><a href={item.href} class="text-[var(--color-ink-soft)] transition hover:text-[var(--color-seal)]">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Visit -->
    <div class="md:col-span-4">
      <h3 class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-gold)]">{t.footer.visit}</h3>
      <address class="mt-4 text-base not-italic leading-relaxed text-[var(--color-ink-soft)]">
        {address}
      </address>
      <a href={mapHref} target="_blank" rel="noopener" class="mt-2 inline-block text-base font-semibold link-underline">{t.contact.mapLabel} →</a>

      <h3 class="mt-6 text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-gold)]">{t.footer.follow}</h3>
      <a href={org.facebook} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-base font-semibold link-underline">
        <i class="ph-bold ph-facebook-logo text-xl"></i>
        Facebook
      </a>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="wrap flex flex-col items-center justify-between gap-2 py-5 text-sm text-[var(--color-muted)] sm:flex-row">
      <p>© {year} {siteName}. {t.footer.rights}.</p>
      <p>{org.addressZh}</p>
    </div>
  </div>
</footer>
