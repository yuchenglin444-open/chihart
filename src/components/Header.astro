---
import { ui, navItems, org, languages, localizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: string;
  compact?: boolean;
}
const { lang, page, compact = false } = Astro.props;
const t = ui[lang];
const items = navItems(lang);
const current = localizedPath(page, lang);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = localizedPath(page, otherLang);
const home = localizedPath('/', lang);
const brandMain = org.abbr;
const brandSub = lang === 'zh' ? org.nameZh : org.nameEn;
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-paper)]/88 backdrop-blur">
  <div
    class:list={[
      'wrap flex items-center justify-between',
      compact ? 'min-h-11 gap-2 py-1 sm:min-h-12 sm:gap-3' : 'min-h-16 gap-3 py-2 sm:min-h-20 sm:gap-4',
    ]}
  >
    <a href={home} class="group flex min-w-0 max-w-[calc(100%-3.5rem)] flex-col leading-tight sm:max-w-[calc(100%-8rem)] xl:max-w-md">
      <span class:list={['font-serif font-bold tracking-[0.12em] text-[var(--color-ink)]', compact ? 'text-lg sm:text-xl' : 'text-xl sm:text-2xl']}>{brandMain}</span>
      <span class="text-[11px] font-medium leading-snug text-[var(--color-muted)] sm:text-xs sm:leading-snug">{brandSub}</span>
    </a>

    <nav class="hidden items-center gap-6 xl:flex" aria-label={t.a11y.mainMenu}>
      {items.map((item) => {
        const active =
          item.href === current ||
          (current !== home && item.href !== home && current.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'relative font-semibold transition-colors hover:text-[var(--color-vermilion)]',
              compact ? 'py-0.5 text-sm' : 'py-1 text-base',
              active ? 'text-[var(--color-azurite-deep)]' : 'text-[var(--color-ink-soft)]',
            ]}
          >
            {item.label}
            {active && <span class="absolute -bottom-0.5 left-0 h-px w-full bg-[var(--color-vermilion)]"></span>}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={switchHref}
        class:list={[
          'hidden rounded-[2px] border border-[var(--color-line)] font-bold tracking-wide text-[var(--color-ink-soft)] transition hover:border-[var(--color-azurite)] hover:text-[var(--color-azurite-deep)] sm:inline-block',
          compact ? 'px-2.5 py-1 text-sm' : 'px-4 py-2 text-base',
        ]}
        hreflang={otherLang}
      >
        {languages[otherLang]}
      </a>

      <button
        id="menu-toggle"
        class:list={[
          'xl:hidden flex items-center justify-center rounded-[2px] border border-[var(--color-line)] text-[var(--color-ink)]',
          compact ? 'h-10 w-10' : 'h-12 w-12',
        ]}
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <i class:list={['ph-bold ph-list', compact ? 'text-2xl' : 'text-3xl']}></i>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-[var(--color-line)] bg-[var(--color-paper)] xl:hidden"
    aria-label={t.a11y.mainMenu}
  >
    <div class="wrap flex flex-col py-3">
      {items.map((item) => {
        const active =
          item.href === current ||
          (current !== home && item.href !== home && current.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'border-b border-[var(--color-line)]/60 py-4 text-lg font-semibold last:border-0',
              active ? 'text-[var(--color-azurite-deep)]' : 'text-[var(--color-ink-soft)]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a href={switchHref} hreflang={otherLang} class="mt-3 py-2 text-base font-bold uppercase tracking-[0.18em] text-[var(--color-azurite)]">
        {lang === 'zh' ? 'English' : '切換中文'} →
      </a>
    </div>
  </nav>
</header>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');
    if (!toggle || !nav) return;
    const clone = toggle.cloneNode(true) as HTMLButtonElement;
    toggle.replaceWith(clone);
    clone.addEventListener('click', () => {
      const open = nav.classList.toggle('hidden') === false;
      clone.setAttribute('aria-expanded', String(open));
    });
  }
  document.addEventListener('astro:page-load', initMenu);
</script>
