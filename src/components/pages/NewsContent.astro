---
import { ui, org, type Lang } from '../../i18n/ui';
import { newsItems } from '../../data/news';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const n = t.news;

const tagLabels: Record<string, { zh: string; en: string }> = {
  exhibition: { zh: '展覽', en: 'Exhibition' },
  competition: { zh: '徵件', en: 'Open call' },
  class: { zh: '課程', en: 'Class' },
  notice: { zh: '公告', en: 'Notice' },
};

function fmtDate(iso: string) {
  const d = new Date(iso);
  return new Intl.DateTimeFormat(lang === 'zh' ? 'zh-TW' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}
---

<PageHeader eyebrow={n.eyebrow} title={n.title} lede={n.lede} />

<section class="wrap py-16 sm:py-20">
  <div class="grid gap-8 lg:grid-cols-12">
    <!-- News list -->
    <ul class="space-y-6 lg:col-span-8">
      {newsItems.map((item) => {
        const title = lang === 'zh' ? item.titleZh : item.titleEn;
        const body = lang === 'zh' ? item.bodyZh : item.bodyEn;
        const tag = tagLabels[item.tag]?.[lang] ?? item.tag;
        return (
          <li class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-7 transition hover:border-[var(--color-jade-soft)]">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-[var(--color-jade)] px-2.5 py-0.5 text-xs font-medium text-[var(--color-jade-deep)]">{tag}</span>
              <time datetime={item.date} class="text-xs text-[var(--color-muted)]">{fmtDate(item.date)}</time>
            </div>
            <h2 class="mt-3 text-xl">{title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">{body}</p>
            {item.link && (
              <a href={item.link} target="_blank" rel="noopener" class="mt-4 inline-block text-sm link-underline">{n.readMore} →</a>
            )}
          </li>
        );
      })}
    </ul>

    <!-- Facebook aside -->
    <aside class="lg:col-span-4">
      <div class="sticky top-24 rounded-[2px] border border-[var(--color-line)] bg-[var(--color-paper-deep)] p-7">
        <h2 class="font-serif text-lg">{n.fbNote}</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
          {lang === 'zh' ? '本會最即時的展覽、活動與作品分享，都在 Facebook 專頁上。' : 'The most up-to-date exhibitions, events and works are all on our Facebook page.'}
        </p>
        <a href={org.facebook} target="_blank" rel="noopener" class="btn btn-primary mt-6 w-full">{n.readMore}</a>
      </div>
    </aside>
  </div>
</section>
