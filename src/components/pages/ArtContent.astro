---
import { ui, localizedPath, type Lang } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const a = t.art;
const classesHref = localizedPath('/classes', lang);
---

<PageHeader eyebrow={a.eyebrow} title={a.title} lede={a.lede} />

<!-- What is gansai -->
<section class="wrap grid gap-12 py-20 lg:grid-cols-12">
  <div class="lg:col-span-5">
    <h2 class="text-2xl sm:text-3xl">{a.whatTitle}</h2>
  </div>
  <div class="space-y-5 text-[var(--color-ink-soft)] lg:col-span-7">
    {a.whatBody.map((p) => <p class="leading-relaxed">{p}</p>)}
  </div>
</section>

<!-- Materials -->
<section class="border-y border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap py-20">
    <h2 class="text-2xl sm:text-3xl">{a.materialsTitle}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {a.materials.map((m) => (
        <div class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-6">
          <h3 class="font-serif text-lg text-[var(--color-jade-deep)]">{m.name}</h3>
          <div class="my-3 hairline"></div>
          <p class="text-base leading-relaxed text-[var(--color-muted)]">{m.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process -->
<section class="wrap py-20">
  <h2 class="text-2xl sm:text-3xl">{a.processTitle}</h2>
  <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {a.process.map((s) => (
      <li class="relative">
        <span class="font-serif text-4xl text-[var(--color-jade)]">{s.step}</span>
        <h3 class="mt-3 text-lg">{s.title}</h3>
        <p class="mt-2 text-base leading-relaxed text-[var(--color-muted)]">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<!-- History -->
<section class="border-t border-[var(--color-line)] bg-[var(--color-jade-deep)] text-[#f1ece0]">
  <div class="wrap grid gap-12 py-20 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-2xl text-[#fdfcf8] sm:text-3xl">{a.historyTitle}</h2>
    </div>
    <div class="space-y-5 lg:col-span-8">
      {a.history.map((p) => <p class="leading-relaxed text-[#f1ece0]/90">{p}</p>)}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="wrap flex flex-col items-center gap-6 py-16 text-center">
  <p class="font-serif text-xl sm:text-2xl">{lang === 'zh' ? '讀萬卷，不如親手畫一筆。' : 'Better than reading, lift a brush yourself.'}</p>
  <a href={classesHref} class="btn btn-primary">{t.cta.trial}</a>
</section>
