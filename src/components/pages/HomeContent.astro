---
import { ui, org, localizedPath, type Lang } from '../../i18n/ui';
import { featuredPaintings } from '../../lib/photos';
import ArtTile from '../ArtTile.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const titleLines = h.heroTitle.split('\n');
const classesHref = localizedPath('/classes', lang);
const galleryHref = localizedPath('/gallery', lang);
const aboutHref = localizedPath('/about', lang);
const contactHref = localizedPath('/contact', lang);
const stats = [
  { value: h.statFounded, label: h.statFoundedLabel },
  { value: h.statFree, label: h.statFreeLabel },
  { value: h.statRegion, label: h.statRegionLabel },
];
const feats = featuredPaintings();
const heroWorks = feats.slice(0, 3);
const artAlt = lang === 'zh' ? '膠彩作品' : 'Gansai painting';
---

<!-- ============================ HERO ============================ -->
<section class="relative overflow-hidden">
  <div class="wrap grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div>
      <span class="eyebrow">{h.heroKicker}</span>
      <h1 class="mt-6 text-4xl leading-[1.15] sm:text-5xl md:text-6xl">
        {titleLines.map((line, i) => (
          <span class="block">{line}</span>
        ))}
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)] sm:text-xl">{h.heroSub}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={classesHref} class="btn btn-primary">{t.cta.trial}</a>
        <a href={galleryHref} class="btn btn-ghost">{t.cta.viewGallery}</a>
      </div>
      <p class="mt-4 text-sm text-[var(--color-muted)]">{t.cta.trialNote}</p>
    </div>

    <!-- artwork cluster -->
    <div class="relative">
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-4 pt-8">
          {heroWorks[0] && <ArtTile src={heroWorks[0]} alt={artAlt} ratio="aspect-[3/4]" />}
          {heroWorks[2] && <ArtTile src={heroWorks[2]} alt={artAlt} ratio="aspect-square" />}
        </div>
        <div class="space-y-4">
          {heroWorks[1] && <ArtTile src={heroWorks[1]} alt={artAlt} ratio="aspect-square" />}
          <div class="rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
            <p class="font-serif text-base leading-relaxed text-[var(--color-ink-soft)]">{lang === 'zh' ? '天然礦物顏料 · 動物膠 · 紙絹' : 'Mineral pigment · animal glue · paper & silk'}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ INTRO + STATS ============================ -->
<section class="border-y border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-7">
      <span class="eyebrow">{h.introEyebrow}</span>
      <h2 class="mt-5 max-w-xl text-2xl leading-snug sm:text-3xl">{h.introTitle}</h2>
      <div class="mt-6 space-y-4 text-[var(--color-ink-soft)]">
        {h.introBody.map((p) => <p class="leading-relaxed">{p}</p>)}
      </div>
      <a href={aboutHref} class="mt-7 inline-block text-base link-underline">{t.cta.learnMore} →</a>
    </div>
    <div class="lg:col-span-5 lg:pl-8">
      <dl class="grid grid-cols-3 gap-6 border-t border-[var(--color-line)] pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        {stats.map((s) => (
          <div>
            <dt class="font-serif text-3xl text-[var(--color-jade-deep)] sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm leading-snug text-[var(--color-muted)]">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- ============================ FEATURED WORKS ============================ -->
<section class="wrap py-20 sm:py-24">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="eyebrow">{h.featEyebrow}</span>
      <h2 class="mt-5 text-2xl sm:text-3xl">{h.featTitle}</h2>
    </div>
    <a href={galleryHref} class="text-base link-underline">{t.cta.allWorks} →</a>
  </div>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">{h.featSub}</p>
  <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
    {feats.slice(0, 8).map((src) => <ArtTile src={src} alt={artAlt} />)}
  </div>
</section>

<!-- ============================ PATHS ============================ -->
<section class="border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap py-20">
    <h2 class="text-center font-serif text-2xl sm:text-3xl">{h.pathsTitle}</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {h.paths.map((p, i) => (
        <a href={localizedPath(p.href, lang)} class="group flex flex-col rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)] p-8 transition hover:-translate-y-1 hover:border-[var(--color-jade)] hover:shadow-sm">
          <span class="font-serif text-base text-[var(--color-seal)]">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-xl">{p.title}</h3>
          <p class="mt-3 flex-1 text-base leading-relaxed text-[var(--color-muted)]">{p.body}</p>
          <span class="mt-6 text-base text-[var(--color-jade-deep)] transition group-hover:text-[var(--color-seal)]">{p.link} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============================ QUOTE ============================ -->
<section class="bg-[var(--color-jade-deep)] text-[#f4efe4]">
  <div class="wrap-narrow py-20 text-center sm:py-24">
    <i class="ph-bold ph-quotes mb-4 block text-5xl opacity-50"></i>
    <blockquote class="font-serif text-2xl leading-relaxed sm:text-3xl">{h.quote}</blockquote>
    <p class="mt-8 text-base tracking-wide text-[#f4efe4]/80">{h.quoteBy}</p>
  </div>
</section>

<!-- ============================ CTA ============================ -->
<section class="wrap py-20 text-center sm:py-24">
  <h2 class="mx-auto max-w-2xl text-2xl leading-snug sm:text-3xl">{lang === 'zh' ? '想親手試試膠彩嗎？' : 'Ready to try gansai for yourself?'}</h2>
  <p class="mx-auto mt-5 max-w-xl text-[var(--color-muted)]">{lang === 'zh' ? '免費體驗課程長期開放，材料由本會提供，歡迎私訊預約。' : 'Free trial classes are always open and materials are provided. Message us to book.'}</p>
  <div class="mt-9 flex flex-wrap justify-center gap-4">
    <a href={classesHref} class="btn btn-primary">{t.cta.trial}</a>
    <a href={contactHref} class="btn btn-ghost">{t.cta.contact}</a>
  </div>
</section>
