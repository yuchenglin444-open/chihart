---
import { ui, asset, type Lang } from '../../i18n/ui';
import { listPhotos } from '../../lib/photos';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const g = t.gallery;
const cats = g.categories as Record<string, string>;

// Read the real photos from public/gallery/<Category>/
const order = ['Painting', 'Class', 'Event'];
const items = order.flatMap((cat) =>
  listPhotos(cat).map((src) => ({ src, cat }))
);

const filters = [{ key: 'all', label: g.filterAll }, ...order.map((k) => ({ key: k, label: cats[k] }))];
const altFor = (cat: string) => (lang === 'zh' ? cats[cat] : cats[cat]);
---

<PageHeader eyebrow={g.eyebrow} title={g.title} lede={g.lede} />

<section class="wrap py-16 sm:py-20">
  <!-- Filters -->
  <div class="flex flex-wrap gap-3" role="group" aria-label={g.filterAll}>
    {filters.map((f, i) => (
      <button
        data-filter={f.key}
        class:list={[
          'gallery-filter rounded-full border px-5 py-2 text-base font-semibold transition',
          i === 0
            ? 'border-[var(--color-jade)] bg-[var(--color-jade)] text-[var(--color-ink)]'
            : 'border-[var(--color-line)] text-[var(--color-ink-soft)] hover:border-[var(--color-jade)]',
        ]}
      >
        {f.label}
      </button>
    ))}
  </div>

  <!-- Masonry grid (CSS columns; preserves each photo's aspect ratio) -->
  <div id="gallery-grid" class="mt-10 gap-4 [column-gap:1rem] columns-2 md:columns-3 lg:columns-4">
    {items.map((it) => (
      <div class="gallery-item mb-4 break-inside-avoid" data-category={it.cat}>
        <img
          src={asset(it.src)}
          alt={altFor(it.cat)}
          loading="lazy"
          decoding="async"
          class="w-full rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)]"
        />
      </div>
    ))}
  </div>

  {items.length === 0 && (
    <p class="mt-10 text-base text-[var(--color-muted)]">{g.note}</p>
  )}
  <p class="mt-10 text-base text-[var(--color-muted)]">{g.credit}</p>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');
  const active = ['border-[var(--color-jade)]', 'bg-[var(--color-jade)]', 'text-[var(--color-ink)]'];
  const idle = ['border-[var(--color-line)]', 'text-[var(--color-ink-soft)]'];
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => { b.classList.remove(...active); b.classList.add(...idle); });
      btn.classList.remove(...idle); btn.classList.add(...active);
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.category === filter;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
