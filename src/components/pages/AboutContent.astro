---
import { ui, org, asset, localizedPath, type Lang } from '../../i18n/ui';
import { founderImage, valueImages } from '../../lib/photos';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const a = t.about;
const contactHref = localizedPath('/contact', lang);
const classesHref = localizedPath('/classes', lang);
const founder = founderImage();
const valImgs = valueImages();
---

<PageHeader eyebrow={a.eyebrow} title={a.title} lede={a.lede} />

<!-- Story -->
<section class="wrap grid gap-12 py-20 lg:grid-cols-12">
  <div class="lg:col-span-4">
    <h2 class="text-2xl sm:text-3xl">{a.storyTitle}</h2>
  </div>
  <div class="space-y-5 text-[var(--color-ink-soft)] lg:col-span-8">
    {a.story.map((p) => <p class="leading-relaxed">{p}</p>)}
  </div>
</section>

<!-- Founder -->
<section class="border-y border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap grid items-center gap-12 py-20 lg:grid-cols-12">
    <div class="lg:col-span-5">
      {founder ? (
        <img
          src={asset(founder)}
          alt={lang === 'zh' ? '創會老師 陳嬋娟' : 'Founding teacher Chen Chan-chuan'}
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full rounded-[2px] border border-[var(--color-line)] object-cover object-top"
        />
      ) : (
        <div
          class="flex aspect-[4/5] w-full items-center justify-center rounded-[2px] border border-[var(--color-line)]"
          style="background:
            radial-gradient(120% 80% at 30% 20%, rgba(255,255,255,0.5), transparent 60%),
            radial-gradient(100% 90% at 80% 90%, rgba(42,36,32,0.12), transparent 55%),
            #bfe8e2;"
          aria-hidden="true"
        >
          <span class="font-serif text-lg text-[var(--color-ink)]/45">{lang === 'zh' ? '陳嬋娟 老師' : 'Teacher Chen'}</span>
        </div>
      )}
    </div>
    <div class="lg:col-span-7">
      <span class="eyebrow">{a.founderRole}</span>
      <h2 class="mt-5 text-2xl sm:text-3xl">{a.founderTitle}</h2>
      <div class="mt-6 space-y-5 text-[var(--color-ink-soft)]">
        {a.founderBody.map((p) => <p class="leading-relaxed">{p}</p>)}
      </div>
    </div>
  </div>
</section>

<!-- Values -->
<section class="wrap py-20">
  <h2 class="text-center text-2xl sm:text-3xl">{a.valuesTitle}</h2>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {a.values.map((v, i) => (
      <div class="flex flex-col overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-surface)]">
        {valImgs[i] && (
          <img
            src={asset(valImgs[i])}
            alt={v.title}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        )}
        <div class="flex flex-1 flex-col p-8">
          <span class="font-serif text-3xl text-[var(--color-jade)]">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-xl">{v.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-[var(--color-muted)]">{v.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="border-t border-[var(--color-line)] bg-[var(--color-paper-deep)]">
  <div class="wrap flex flex-col items-center gap-6 py-16 text-center">
    <p class="font-serif text-xl sm:text-2xl">{lang === 'zh' ? '歡迎來畫室坐坐，認識膠彩。' : 'Come by the studio and discover gansai.'}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={classesHref} class="btn btn-primary">{t.cta.trial}</a>
      <a href={contactHref} class="btn btn-ghost">{t.cta.contact}</a>
    </div>
  </div>
</section>
