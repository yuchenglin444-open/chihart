---
import { ui, org, type Lang } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contact;
const address = lang === 'zh' ? org.addressZh : org.addressEn;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(org.mapsQuery)}&hl=${lang === 'zh' ? 'zh-TW' : 'en'}&z=17&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(org.mapsQuery)}`;
---

<PageHeader eyebrow={c.eyebrow} title={c.title} lede={c.lede} />

<section class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-12">
  <!-- Details -->
  <div class="space-y-8 lg:col-span-5">
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.addressLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{address}</p>
      <a href={mapLink} target="_blank" rel="noopener" class="mt-2 inline-block text-base link-underline">{c.mapLabel} →</a>
    </div>

    <div class="hairline"></div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.hoursLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{c.hours}</p>
    </div>

    <div class="hairline"></div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.messageLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{c.messageBody}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={org.facebook} target="_blank" rel="noopener" class="btn btn-primary">
          <i class="ph-bold ph-facebook-logo text-2xl"></i>
          Facebook
        </a>
        <a href={org.messenger} target="_blank" rel="noopener" class="btn btn-ghost">
          <i class="ph-bold ph-messenger-logo text-2xl"></i>
          Messenger
        </a>
      </div>
    </div>
  </div>

  <!-- Map (iframe with a graceful fallback layer behind it) -->
  <div class="lg:col-span-7">
    <div class="relative h-[460px] overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-paper-deep)]">
      <!-- fallback shown if the embed can't load -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-8 text-center">
        <i class="ph-bold ph-map-pin text-5xl text-[var(--color-jade-deep)]"></i>
        <p class="text-base text-[var(--color-ink-soft)]">{address}</p>
        <a href={mapLink} target="_blank" rel="noopener" class="text-base link-underline">{c.mapLabel} →</a>
      </div>
      <iframe
        title={lang === 'zh' ? '本會位置地圖' : 'Location map'}
        src={mapEmbed}
        class="absolute inset-0 h-full w-full"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
