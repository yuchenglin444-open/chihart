---
import { ui, org, type Lang } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contact;
const address = lang === 'zh' ? org.addressZh : org.addressEn;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(org.mapsQuery)}&hl=${lang === 'zh' ? 'zh-TW' : 'en'}&z=17&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(org.mapsQuery)}`;
---

<PageHeader eyebrow={c.eyebrow} title={c.title} lede={c.lede} />

<section class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-12">
  <!-- Details -->
  <div class="space-y-8 lg:col-span-5">
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.addressLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{address}</p>
      <a href={mapLink} target="_blank" rel="noopener" class="mt-2 inline-block text-sm link-underline">{c.mapLabel} →</a>
    </div>

    <div class="hairline"></div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.hoursLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{c.hours}</p>
    </div>

    <div class="hairline"></div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-gold)]">{c.messageLabel}</h2>
      <p class="mt-3 leading-relaxed text-[var(--color-ink-soft)]">{c.messageBody}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={org.facebook} target="_blank" rel="noopener" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          Facebook
        </a>
        <a href={org.messenger} target="_blank" rel="noopener" class="btn btn-ghost">Messenger</a>
      </div>
    </div>
  </div>

  <!-- Map (iframe with a graceful fallback layer behind it) -->
  <div class="lg:col-span-7">
    <div class="relative h-[460px] overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-paper-deep)]">
      <!-- fallback shown if the embed can't load -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-8 text-center">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-jade)" stroke-width="1.5"><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <p class="text-sm text-[var(--color-ink-soft)]">{address}</p>
        <a href={mapLink} target="_blank" rel="noopener" class="text-sm link-underline">{c.mapLabel} →</a>
      </div>
      <iframe
        title={lang === 'zh' ? '本會位置地圖' : 'Location map'}
        src={mapEmbed}
        class="absolute inset-0 h-full w-full"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
